    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-leaflet": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.17",
    "axios": "^1.8.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
