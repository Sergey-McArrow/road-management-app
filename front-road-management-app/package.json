    "@eslint/js": "^9.21.0",
    "@types/cypress": "^1.1.6",
    "cypress": "^14.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "start-server-and-test": "^1.15.5",
    "typescript-eslint": "^8.24.1"
